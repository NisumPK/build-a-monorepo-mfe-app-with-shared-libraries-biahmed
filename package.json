    "@nx/vite": "^23.1.2",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "nx": "^23.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
