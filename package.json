{
  "name": "build-a-monorepo-mfe-app-with-shared-libraries-biahmed",
  "version": "1.0.0",
  "description": "## 📌 Overview",
  "main": "index.js",
  "scripts": {
    "shop:dev": "cd apps/shop && npm run dev",
    "shell:dev": "cd apps/shell && npm run dev",
    "dev": "npm install && npm --prefix apps/shop install && npm --prefix apps/shell install && concurrently -k -n shop,shell -c blue,green \"npm --prefix apps/shop run dev\" \"npm --prefix apps/shell run dev\""
  },
